# Digital Futures: settings for one environment. Copy to .env next to docker-compose.yml and fill in.
# Never commit the filled-in file. Generate secrets with:  openssl rand -base64 48

# ---------------------------------------------------------------- Deployment (docker compose only)
# Docker Hub account the images are published under (public images: no sign-in needed to pull).
IMAGE_NAMESPACE=19631
# test | prod: names the compose project and its volumes.
DEPLOY_ENV=test
# Which image to run: test (Test environment), prod (Production), or sha-<commit> to pin an exact build.
IMAGE_TAG=test
# Host port for the web container; the HTTPS proxy forwards to it.
WEB_PORT=8080

# ---------------------------------------------------------------- Public addresses
# The site's public HTTPS address, no trailing slash. Used in every email link (test invitations,
# password resets, registration invitations) and as the only browser origin allowed to call the API.
FRONTEND_BASE_URL=https://digitalfutures.duckdns.org
# Same address unless the API is published separately. Used for the optional single sign-on callback.
BACKEND_BASE_URL=https://digitalfutures.duckdns.org
# Extra browser origins allowed to call the API (comma separated). Normally empty.
CORS_ALLOWED_ORIGINS=
# Leave empty when proxies in front are on private addresses (the usual case). If the HTTPS proxy is
# on a public address, set the number of proxies in front of the API (web container + proxy = 2).
TRUST_PROXY=

# ---------------------------------------------------------------- Security
# Signs staff sessions and one-time codes. 48+ random characters, different per environment.
# Changing it signs everyone out.
AUTH_TOKEN_SECRET=
# Optional separate secret for applicant one-time codes (defaults to AUTH_TOKEN_SECRET).
OTP_SECRET=
# Only while creating the first super admin (see DEPLOYMENT.md). Remove afterwards.
BOOTSTRAP_ADMIN_TOKEN=
STAFF_TOKEN_EXPIRY_HOURS=8
PASSWORD_RESET_EXPIRES_MINUTES=60
# Unfinished applications not saved for this many days are erased (minimum 7).
DRAFT_RETENTION_DAYS=90
# A participant registration form stays open this many minutes after the last save (minimum 5).
REGISTRATION_SESSION_IDLE_MINUTES=120

# ---------------------------------------------------------------- Database (MySQL 8)
# Bundled MySQL container (profile "bundled"): the host is "mysql".
MYSQL_DATABASE=digital_futures
MYSQL_USER=df_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=mysql://df_app:CHANGE_ME@mysql:3306/digital_futures
# Managed MySQL (e.g. Azure Database for MySQL Flexible Server) instead, with TLS:
# DATABASE_URL=mysql://df_app:PASSWORD@your-server.mysql.database.azure.com:3306/digital_futures?sslaccept=strict

# ---------------------------------------------------------------- Document storage (MinIO)
# Administrator account of the MinIO container.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# What the API uses. The API creates the private bucket on first start. The root account works; a MinIO
# user limited to this bucket is better.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=digital-futures-documents

# ---------------------------------------------------------------- Email (SMTP)
# Required in Test and Production: invitations, reset links, one-time codes and rejection reasons.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Digital Futures
SMTP_FROM_EMAIL=
PARTICIPANT_REGISTRATION_SUPPORT_EMAIL=

# ---------------------------------------------------------------- Programme settings
ORGANISATION_PREFIX=SS
PROJECT_PREFIX=DF
BASIC_SKILLS_TEST_INVITE_EXPIRY_DAYS=14
PARTICIPANT_REGISTRATION_INVITE_EXPIRY_DAYS=14
# Channels for applicant one-time codes: email (default), whatsapp, or email,whatsapp
OTP_CHANNELS=email

# ---------------------------------------------------------------- Optional: WhatsApp codes
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=

# ---------------------------------------------------------------- Optional: staff single sign-on (OIDC)
SSO_ENABLED=false
SSO_PROVIDER_NAME=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZATION_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_REDIRECT_URI=
SSO_SCOPE=openid email profile
SSO_ALLOWED_EMAIL_DOMAINS=
SSO_AUTO_CREATE_USERS=false
SSO_DEFAULT_ROLE=
SSO_DEFAULT_COUNTRY=
